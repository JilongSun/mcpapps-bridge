bridge:
  apiHost: 127.0.0.1
  apiPort: 8765
  # Required when Agent Host is enabled. Use the origin reachable by Hermes, such as
  # http://127.0.0.1:8765, http://mabrid:8765, or https://mabrid.internal.example.com.
  # advertisedBaseUrl: http://127.0.0.1:8765
  # proxyName: enterprise-ops-hub  # uncomment to set a fixed downstream name
  # httpxTimeoutSeconds: 30  # HTTP request timeout in seconds (default: 30)

storage:
  sqlitePath: ./backend/var/mabrid.db
  autoMigrate: true

endpoints:
  test-endpoint:
    displayName: Test Endpoint
    mode: aggregate
    bindings:
      - upstream: enterprise-ops-hub-http-1
        namespace: ops-one
        priority: 10
      - upstream: enterprise-ops-hub-http-2
        namespace: ops-two
        priority: 20

upstreams:
  enterprise-ops-hub-http-1:
    transport: streamable-http
    url: http://localhost:8760/mcp
    # headers: {}

  enterprise-ops-hub-http-2:
    transport: streamable-http
    url: http://localhost:8759/mcp
    # headers: {}
